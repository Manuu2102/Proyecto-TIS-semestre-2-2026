DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Solo pruebas: habilita /dev/reloj para simular la hora de expensas y moras. No usar en produccion.
RELOJ_SIMULADO=false

# Correo. Si se dejan vacias, no se envian correos.
# Remitente: con Brevo debe ser un remitente verificado en la cuenta de Brevo.
MAIL_FROM="Edificio - Pagos <correo@gmail.com>"
# Opcion 1 (recomendada en la nube): Brevo por API. Si esta definida, se ignora el SMTP de abajo.
BREVO_API_KEY=
# Opcion 2 (local): SMTP, por ejemplo Gmail con contrasena de aplicacion.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
