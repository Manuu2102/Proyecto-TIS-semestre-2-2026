DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Solo pruebas: habilita /dev/reloj para simular la hora de expensas y moras.
# No usar en producción.
RELOJ_SIMULADO=false

# Azure Blob Storage
# La autenticación se realiza mediante DefaultAzureCredential.
# En Azure se utilizará la Managed Identity asignada a la VM.
AZURE_STORAGE_ACCOUNT_NAME=tisstagingbackups
AZURE_STORAGE_CONTAINER_NAME=tis-database-backups

# Correo. Si se dejan vacías, no se envían correos.
# Remitente: con Brevo debe ser un remitente verificado en la cuenta de Brevo.
MAIL_FROM="Edificio - Pagos <correo@gmail.com>"

# Opción 1 (recomendada en la nube): Brevo por API.
# Si está definida, se ignora el SMTP de abajo.
BREVO_API_KEY=

# Opción 2 (local): SMTP, por ejemplo Gmail con contraseña de aplicación.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=